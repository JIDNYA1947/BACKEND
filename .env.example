# Copy this file to .env and fill in values as needed.
# The application works out of the box with the defaults below (DEMO_MODE=true),
# no Twilio credentials required.

# --- Demo mode ---
# true  -> WhatsApp messages are simulated/logged, no Twilio account needed
# false -> real messages are sent via Twilio WhatsApp Sandbox (credentials required)
DEMO_MODE=true

# --- Twilio WhatsApp Sandbox (only required when DEMO_MODE=false) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Scheduler ---
# How often (in minutes) the periodic post-loan health-check survey is sent.
# Kept small for demo purposes; represents a compressed "months" cadence in production.
SURVEY_INTERVAL_MINUTES=3

# --- Mentor alert rule ---
# Number of concerning answers (out of 3) required to trigger a mentor alert.
CONCERNING_ANSWER_ALERT_THRESHOLD=2

# --- Database ---
# Path to the SQLite database file. Defaults to app_data.db in the project root.
DATABASE_PATH=app_data.db
